# Copy to .env.local and fill in. Never commit real values.
# Values containing "#" or spaces must be wrapped in double quotes.

# ── Database (required) ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/?retryWrites=true&w=majority
MONGODB_DB_NAME=onkurlms

# ── Auth (required) ────────────────────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Public base URL used in every email link (never derived from the Host header)
APP_URL=http://localhost:3000
# Optional tuning
# SESSION_TTL_HOURS=168
# VERIFICATION_TOKEN_TTL_MINUTES=1440
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# ── Cloudinary (required for uploads and protected media) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary token-based auth key for expiring video URLs
# CLOUDINARY_AUTH_TOKEN_KEY=
# MAX_VIDEO_MB=500
# MAX_DOCUMENT_MB=25
# MAX_IMAGE_MB=5

# ── Email / SMTP (required for registration) ───────────────────────────
EMAIL_FROM="Onkuron <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Keep true in production; false only for a local mail catcher
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# ── Shared teacher account ─────────────────────────────────────────────
TEACHER_EMAIL=
TEACHER_PASSWORD=
# true = provision the teacher on first DB connection; turn off afterwards
SEED_INITIAL_TEACHER=false

# ── Background jobs ────────────────────────────────────────────────────
# Bearer secret for GET/POST /api/internal/jobs (32+ chars)
CRON_SECRET=
